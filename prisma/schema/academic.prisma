enum Degree {
  MSC     @map("MSc")
  MBA     @map("MBA")
  MPHIL   @map("MPhil")
  PHD     @map("PhD")
  POSTDOC @map("Postdoc")
  OTHER   @map("Other")

  @@map("degree")
}

model Institution {
  id        String   @id @default(uuid())
  name      String   @unique
  website   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  higherStudies  HigherStudy[]
  sscProfiles     Profile[]     @relation("SscInstitution")
  hscProfiles     Profile[]     @relation("HscInstitution")

  @@map("institutions")
}

model HigherStudy {
  id             String      @id @default(uuid())
  studentId      String      @map("student_id")
  student        Profile     @relation(fields: [studentId], references: [id])
  institutionId  String      @map("institution_id")
  institution    Institution @relation(fields: [institutionId], references: [id])
  degree         Degree
  field           String?     @db.VarChar(50)
  graduationYear Int?        @map("graduation_year") @db.SmallInt
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([institutionId])
  @@map("higher_studies")
}

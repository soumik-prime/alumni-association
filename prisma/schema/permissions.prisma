enum PermissionCategory {
  PROFILE               @map("Profile")
  DIRECTORY             @map("Directory")
  USER_MANAGEMENT       @map("User Management")
  PERMISSION_MANAGEMENT @map("Permission Management")
  NOTIFICATIONS         @map("Notifications")
  REFERENCE_DATA        @map("Reference Data")
  PUBLICATIONS          @map("Publications")
  BLOGS                 @map("Blogs")
  REPORTS               @map("Reports")
  LOGS                  @map("Logs")
  SYSTEM                @map("System")

  @@map("permission_category")
}

model Permission {
  key         String             @id @db.VarChar(100)
  description String?            @db.VarChar(160)
  category    PermissionCategory?

  userPermissions UserPermission[]
  groupItems      PermissionGroupItem[]

  @@index([category])
  @@map("permissions")
}

model UserPermission {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  user          User       @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String     @map("permission_key")
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  grantedById String?  @map("granted_by_id")
  grantedBy   User?    @relation("GrantedPermissions", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime @default(now()) @map("granted_at")

  expireAt DateTime? @map("expire_at") // natural, time-based expiry

  revokedById String?   @map("revoked_by_id")
  revokedBy   User?     @relation("RevokedPermissions", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime? @map("revoked_at") // explicit, manual revoke

  @@index([userId, permissionKey])
  @@index([grantedById])
  @@index([revokedById])
  @@index([permissionKey])
  @@map("user_permissions")
}

model PermissionGroup {
  id          String  @id @default(uuid())
  name        String  @unique
  description String  @db.VarChar(160)
  isSystem    Boolean @default(false) @map("is_system") // seeded/protected groups (e.g. Super Admin) — app layer blocks edit/delete on these

  permissionItems PermissionGroupItem[]
  userGroups      UserPermissionGroup[]

  @@map("permission_groups")
}

model PermissionGroupItem {
  groupId       String          @map("group_id")
  group         PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissionKey String          @map("permission_key")
  permission    Permission      @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([groupId, permissionKey])
  @@index([permissionKey])
  @@map("permission_group_items")
}

model UserPermissionGroup {
  userId    String          @map("user_id")
  user      User            @relation("UserGroups", fields: [userId], references: [id], onDelete: Cascade)
  groupId   String          @map("group_id")
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  grantedAt DateTime        @default(now()) @map("granted_at")

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_permission_groups")
}
